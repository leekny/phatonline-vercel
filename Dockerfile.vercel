FROM node:22-bookworm-slim

ENV NODE_ENV=production
ENV NO_BROWSER=1
ENV PORT=3000
ENV DATA_DIR=/tmp/phatonline-data
ENV PYTHON_BIN=/opt/zerotts-venv/bin/python

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-venv python3-pip ffmpeg libsndfile1 \
    build-essential git curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package*.json ./
RUN npm ci --omit=dev

COPY . .

RUN python3 -m venv /opt/zerotts-venv \
    && /opt/zerotts-venv/bin/pip install --no-cache-dir --upgrade pip setuptools wheel \
    && /opt/zerotts-venv/bin/pip install --no-cache-dir zerotts pillow

RUN mkdir -p /tmp/phatonline-data/tts-cache /tmp/phatonline-data/music

EXPOSE 3000
CMD ["npm", "start"]
